# YugabyteDB
YB_URL=postgresql://yugabyte:yugabyte@localhost:5433/yugabyte

# Meko product gateway credentials. Set values in your local environment only.
MEKO_MCP_URL=https://mcp.mekodata.ai/mcp
# Codex coding-agent key. Keep scoped to the separate <team>-build datapack.
MEKO_MCP_TOKEN=
# Product role keys belong to their respective Meko accounts and are selected explicitly.
MEKO_TRIAGE_TOKEN=
MEKO_BRIDGE_TOKEN=
MEKO_CURATOR_TOKEN=
MEKO_APPROVER_TOKEN=
# Stable Meko agent namespace IDs; these do not replace account/datapack permissions.
MEKO_TRIAGE_AGENT_ID=
MEKO_BRIDGE_AGENT_ID=
MEKO_CURATOR_AGENT_ID=
MEKO_APPROVER_AGENT_ID=
MEKO_TRIAGE_DATAPACK_ID=
MEKO_BRIDGE_DATAPACK_ID=
MEKO_COMMONS_DATAPACK_ID=
MEKO_SPIKE_DATAPACK_ID=
MEKO_MODE=on
STUB_MEKO=false

# Local-first model with a configurable Gemini fallback.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# YugabyteDB
YB_URL=postgresql://yugabyte:yugabyte@localhost:5433/commonground

# Meko product gateway credentials. Set values in your local environment only.
MEKO_MCP_URL=https://mcp.mekodata.ai/mcp
MEKO_MCP_TOKEN=
MEKO_AGENTS_TOKEN=
MEKO_APPROVER_TOKEN=
MEKO_SPIKE_DATAPACK_ID=
MEKO_MODE=on
STUB_MEKO=false

# Local-first model with a configurable Gemini fallback.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
